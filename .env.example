# Conexión a Base de Datos Neon Postgres (Serverless)
# Formato: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth Secret (Clave para cifrado de sesiones y tokens)
BETTER_AUTH_SECRET="mtc_secret_development_key_change_in_production_32_chars"

# URL base de la aplicación
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
